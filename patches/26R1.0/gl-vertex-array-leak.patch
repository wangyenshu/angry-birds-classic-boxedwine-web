+// glVertexAttribPointer: every attribute index, 0 included, has its own entry. (Index 0 used to
+// share the glVertexPointer entry, so refreshing it before a draw re-pointed the fixed-function
+// vertex array instead of attribute 0, and shaders read positions from a stale pointer.)
+GLvoid* marshalVertexAttribPointer(CPU* cpu, GLuint index, GLboolean normalized, GLint size, GLenum type, GLsizei stride, U32 ptr) {
+    OpenGLVetexPointerPtr found = cpu->thread->glVertextPointersByIndex.get(index);
+    if (ARRAY_BUFFER()) {
+        if (found) {
+            found->isArrayBuffer = true;
+            found->refreshEachCall = 0;
+        }
+        return (GLvoid*)(uintptr_t)ptr;
+    }
+    if (!found) {
+        found = std::make_shared<OpenGLVetexPointer>();
+        cpu->thread->glVertextPointersByIndex.set(index, found);
+    }
+    OpenGLVetexPointer* p = found.get();
+    p->isArrayBuffer = false;
+    p->size = size;
+    p->type = type;
+    p->stride = stride;
+    p->ptr = ptr;
+    p->refreshEachCall = 1;
+    p->normalized = normalized != GL_FALSE;
+    updateVertexPointer(cpu, p, 0);
+    return ptr ? p->marshal : 0;
+}

+// Largest index of an indexed draw whose indices are in the bound GL_ELEMENT_ARRAY_BUFFER.
+U32 getLargestIndexInElementBuffer(GLenum type, GLsizei count, U32 offset) {
+    if (count <= 0) {
+        return 0;
+    }
+#ifndef DISABLE_GL_EXTENSIONS
+    if (ext_glGetBufferSubData) {
+        U32 typeSize = (type == GL_UNSIGNED_BYTE) ? 1 : ((type == GL_UNSIGNED_SHORT) ? 2 : 4);
+        static thread_local std::vector<U8> indexes;
+        indexes.resize((size_t)count * typeSize);
+        GL_FUNC(ext_glGetBufferSubData)(GL_ELEMENT_ARRAY_BUFFER, (GLintptr)offset, (GLsizeiptr)count * typeSize, indexes.data());
+        return getLargestIndexInType(type, count, indexes.data());
+    }
+#endif
+    return count - 1;
+}

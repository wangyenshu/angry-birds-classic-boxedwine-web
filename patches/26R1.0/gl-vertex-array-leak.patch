+// Host pointer to [address, address + len) if those guest pages sit next to each other in
+// host memory, otherwise nullptr.
+static U8* contiguousRam(KMemory* memory, U32 address, U32 len) {
+    U32 page = address >> K_PAGE_SHIFT;
+    U32 offset = address & K_PAGE_MASK;
+    U8* ram = memory->getRamPtr(page << K_PAGE_SHIFT, K_PAGE_SIZE, false);
+    if (!ram) {
+        return nullptr;
+    }
+    U32 pages = (offset + len + K_PAGE_SIZE - 1) >> K_PAGE_SHIFT;
+    for (U32 i = 1; i < pages; i++) {
+        if (memory->getRamPtr((page + i) << K_PAGE_SHIFT, K_PAGE_SIZE, false) != ram + i * K_PAGE_SIZE) {
+            return nullptr;
+        }
+    }
+    return ram + offset;
+}
